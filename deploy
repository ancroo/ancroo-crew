#!/usr/bin/env bash
# Install or update the company on a server, the one way that is offered. See README, "Install", and docs/operation.md.
#
#   ./deploy                    build the code on the server and (re)start the service; on an empty server this
#                               is the installation
#   ./deploy --force            also while an employee is running
#   ./deploy --rollback         back to the image of the previous deploy
#   ./deploy --reset-password   new password for the owner
#
# Needs git and ssh here, Docker on the server. Settings come from company.env (COMPANY_ENV names another file).
set -euo pipefail

cd "$(dirname "$(readlink -f "$0")")"

info() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
fail() { printf '\033[1;31mError:\033[0m %s\n' "$*" >&2; exit 1; }

ENV_FILE=${COMPANY_ENV:-company.env}
[[ -f "$ENV_FILE" ]] || fail "$ENV_FILE is missing. Copy company.env.example to company.env and fill it in."

# Read KEY=value lines without running the file as a script.
declare -A SETTING=()
SETTING_KEYS=()
while IFS= read -r line || [[ -n "$line" ]]; do
  [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue
  [[ "$line" =~ ^([A-Z_][A-Z0-9_]*)=(.*)$ ]] || fail "$ENV_FILE: cannot read the line: $line"
  key=${BASH_REMATCH[1]}
  value=${BASH_REMATCH[2]}
  value=${value%\"}; value=${value#\"}; value=${value%\'}; value=${value#\'}
  SETTING[$key]=$value
  SETTING_KEYS+=("$key")
done < "$ENV_FILE"

SERVER=${SETTING[SERVER]:-}
BASE=${SETTING[BASE]:-/opt/company}
NAME=${SETTING[NAME]:-company}
PORT=${SETTING[PORT]:-8700}
TZ_VALUE=${SETTING[TZ]:-UTC}
NETWORK=${SETTING[COMPANY_NETWORK]:-$NAME-agents}
IMAGE=${SETTING[COMPANY_IMAGE]:-$NAME-agent}
# Runs of another installation on the same server must not hold up this one.
RUN_PREFIX=$NAME-run-

[[ -n "$SERVER" ]] || fail "SERVER is missing in $ENV_FILE, e.g. SERVER=admin@server.example"
[[ "$BASE" == /* && "$BASE" != / ]] || fail "BASE must be an absolute folder, e.g. /opt/company"
[[ "$NAME" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || fail "NAME may contain only lower-case letters, digits, - and _"
[[ "$PORT" =~ ^[0-9]+$ ]] || fail "PORT must be a number"

mode=deploy
force=false
for arg in "$@"; do
  case "$arg" in
    --force) force=true ;;
    --rollback) mode=rollback ;;
    --reset-password) mode=password ;;
    *) fail "Unknown option: $arg" ;;
  esac
done

quoted() { printf '%q' "$1"; }
# remote runs a command with these arguments on the server, each one quoted. remote_sh runs a whole shell script.
remote() { local command="" arg; for arg in "$@"; do command+="$(quoted "$arg") "; done; ssh -o BatchMode=yes "$SERVER" "$command"; }
remote_sh() { ssh -o BatchMode=yes "$SERVER" "$1"; }

remote true || fail "No SSH connection to $SERVER."
remote docker version --format '{{.Server.Version}}' >/dev/null 2>&1 \
  || fail "Docker does not answer on $SERVER. Is the user in the group docker?"

COMPOSE="$BASE/compose.yml"

if [[ $mode == password ]]; then
  remote docker inspect "$NAME" >/dev/null 2>&1 || fail "There is no container $NAME on $SERVER."
  read -rsp "New password for the owner: " first; echo
  read -rsp "Once more: " second; echo
  [[ "$first" == "$second" ]] || fail "The two passwords differ."
  printf '%s\n' "$first" | remote docker exec -i "$NAME" .venv/bin/python -m app.cli reset-password
  exit 0
fi

if ! $force; then
  # A run survives a restart of the service as an orphaned container: it keeps working and may write into the
  # company, while the service already counts it as cancelled. So look first.
  # The filter matches anywhere in the name, so "company-run-" would also find "my-company-run-"; grep keeps the start.
  runs=$(remote docker ps --filter "name=$RUN_PREFIX" --format '{{.Names}} ({{.RunningFor}})')
  runs=$(grep "^$RUN_PREFIX" <<< "$runs" || true)
  [[ -z "$runs" ]] || fail "An employee is working right now:
$runs
Try again later, or with --force."
fi

wait_for_service() {
  info "Waiting for the service"
  for _ in $(seq 1 30); do
    if remote docker exec "$NAME" .venv/bin/python -c \
        "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8700/static/style.css', timeout=2)" \
        >/dev/null 2>&1; then
      info "Running: $NAME on $SERVER, port 127.0.0.1:$PORT. Open it with: ssh -L $PORT:127.0.0.1:$PORT $SERVER"
      return 0
    fi
    sleep 1
  done
  printf '\033[1;31mError:\033[0m The service does not answer. The last lines of its log:\n' >&2
  remote docker logs --tail 30 "$NAME" >&2 || true
  return 1
}

if [[ $mode == rollback ]]; then
  previous=$(remote_sh "tail -n 2 $(quoted "$BASE/deploys.log") 2>/dev/null | head -n 1" | cut -f2)
  current=$(remote_sh "tail -n 1 $(quoted "$BASE/deploys.log") 2>/dev/null" | cut -f2)
  [[ -n "$previous" && "$previous" != "$current" ]] || fail "There is no earlier deploy to go back to."
  info "Back from $NAME:$current to $NAME:$previous"
  remote docker tag "$NAME:$previous" "$NAME:local"
  remote docker compose -f "$COMPOSE" up -d
  remote_sh "printf '%s\t%s\t%s\n' \"\$(date -Is)\" $(quoted "$previous") rollback >> $(quoted "$BASE/deploys.log")"
  wait_for_service
  exit $?
fi

# Never on top of something else: the base folder is empty, or holds an installation of this code.
# The script is evaluated on the server, so its expressions stay in single quotes here.
# shellcheck disable=SC2016
check='b=$1; if [ -e "$b" ]; then for entry in "$b"/* "$b"/.[!.]*; do [ -e "$entry" ] || continue; case "${entry##*/}" in company|data|backups|compose.yml|deploys.log) ;; *) echo "$entry"; exit 3 ;; esac; done; if [ -d "$b/company" ] && [ -n "$(ls -A "$b/company")" ] && [ ! -f "$b/company/.schema" ]; then echo "$b/company"; exit 3; fi; fi'
if ! foreign=$(remote sh -c "$check" - "$BASE"); then
  fail "$BASE on $SERVER holds something that is not an installation of this code: $foreign
Choose an empty folder as BASE. Nothing was changed."
fi

if ! remote docker inspect "$NAME" >/dev/null 2>&1; then
  taken=$(remote docker ps --format '{{.Names}} {{.Ports}}' | grep -F "127.0.0.1:$PORT->" || true)
  [[ -z "$taken" ]] || fail "Port $PORT on $SERVER is used by: $taken. Choose another PORT."
fi

# The code: the commit, plus changes not committed yet to files Git knows.
revision=$(git stash create)
revision=${revision:-HEAD}
tag=$(git rev-parse --short HEAD)
git diff --quiet HEAD -- || tag="$tag-modified"
tag="$tag-$(date +%Y%m%d%H%M%S)"

info "Building $NAME:$tag on $SERVER"
git archive --format=tar "$revision" | remote docker build -q -t "$NAME:$tag" -t "$NAME:local" - >/dev/null

info "Building $IMAGE with the latest Claude Code"
git archive --format=tar "$revision" agent \
  | remote docker build -q --pull --no-cache -f agent/Dockerfile -t "$IMAGE:$tag" -t "$IMAGE:latest" - >/dev/null
info "Claude Code: $(remote docker run --rm "$IMAGE:latest" claude --version)"

uid=$(remote id -u)
gid=$(remote id -g)
docker_gid=$(remote stat -c %g /var/run/docker.sock)

yaml() { printf "'%s'" "${1//\'/\'\'}"; }
environment="      COMPANY_DIR: $(yaml "$BASE/company")
      COMPANY_DB: $(yaml "$BASE/data/company.db")
      COMPANY_BACKUPS: $(yaml "$BASE/backups")
      COMPANY_NETWORK: $(yaml "$NETWORK")
      COMPANY_IMAGE: $(yaml "$IMAGE")
      COMPANY_RUN_PREFIX: $(yaml "$RUN_PREFIX")
      TZ: $(yaml "$TZ_VALUE")"
for key in "${SETTING_KEYS[@]}"; do
  case "$key" in
    COMPANY_DIR|COMPANY_DB|COMPANY_BACKUPS|COMPANY_NETWORK|COMPANY_IMAGE|COMPANY_RUN_PREFIX|COMPANY_HOST|COMPANY_PORT) ;;
    COMPANY_*) environment+=$'\n'"      $key: $(yaml "${SETTING[$key]}")" ;;
  esac
done

compose="# Written by deploy. Changes here are overwritten by the next deploy; change company.env instead.
name: $NAME
services:
  app:
    image: $NAME:local
    pull_policy: never
    container_name: $NAME
    restart: unless-stopped
    # The UID of the server's user, so that the company, Git and the runs (docker run --user) have one owner.
    user: '$uid:$gid'
    # The group of the Docker socket. Access to the socket is as powerful as root on the server.
    group_add:
      - '$docker_gid'
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /tmp:nosuid,nodev
    ports:
      - '127.0.0.1:$PORT:8700'
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      # Under the same path: the service passes these paths to docker run, and the daemon reads them on the host.
      - $(yaml "$BASE:$BASE")
    environment:
$environment
    deploy:
      resources:
        limits:
          memory: 512M
          cpus: '1.0'
"

info "Writing $COMPOSE"
remote mkdir -p "$BASE/company" "$BASE/data" "$BASE/backups" \
  || fail "Cannot create $BASE on $SERVER. Create it once as root and give it to the SSH user."
remote chmod 700 "$BASE/backups"
printf '%s' "$compose" | remote_sh "cat > $(quoted "$COMPOSE")"
remote_sh "docker network inspect $(quoted "$NETWORK") >/dev/null 2>&1 || docker network create $(quoted "$NETWORK") >/dev/null"

# Images of earlier deploys. Of the service the last three stay for --rollback; the runs use only $IMAGE:latest.
# Only tags from deploys.log are touched, so images of other installations on the server stay.
clean_up_images() {
  local tags=() old=() kept=0 i t legacy ours
  local -A seen=()
  mapfile -t tags < <(remote_sh "cut -f2 $(quoted "$BASE/deploys.log")")
  for (( i=${#tags[@]}-1; i>=0; i-- )); do
    t=${tags[i]}
    [[ -n "$t" && -z "${seen[$t]:-}" ]] || continue
    seen[$t]=1
    if (( kept < 3 )); then kept=$((kept + 1)); else old+=("$NAME:$t"); fi
    [[ "$t" != "$tag" ]] || continue
    old+=("$IMAGE:$t")
    # Until October 2026 the image of the runs was company-agent for every installation.
    [[ "$IMAGE" == company-agent ]] || old+=("company-agent:$t")
  done
  # Its latest goes only if this installation built it: then it is the same image as one of our tags.
  if [[ "$IMAGE" != company-agent && ${#tags[@]} -gt 0 ]]; then
    legacy=$(remote docker image inspect --format '{{.Id}}' company-agent:latest 2>/dev/null || true)
    ours=$(remote docker image inspect --format '{{.Id}}' "${tags[@]/#/company-agent:}" 2>/dev/null || true)
    [[ -n "$legacy" ]] && grep -qxF "$legacy" <<< "$ours" && old+=(company-agent:latest)
  fi
  (( ${#old[@]} )) || return 0
  info "Removing images of earlier deploys"
  # Tags that are gone already are not an error.
  remote docker image rm "${old[@]}" >/dev/null 2>&1 || true
}

info "Starting $NAME"
remote docker compose -f "$COMPOSE" up -d --remove-orphans
remote_sh "printf '%s\t%s\t%s\n' \"\$(date -Is)\" $(quoted "$tag") deploy >> $(quoted "$BASE/deploys.log")"
wait_for_service
clean_up_images
