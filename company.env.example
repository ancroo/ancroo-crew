# Settings for ./deploy. Copy to company.env (not in Git) and fill in.

# The server, reached over SSH with key or certificate. The user must be in the group docker there.
SERVER=admin@server.example

# Everything of this installation lives below this folder on the server: company/, data/, backups/, compose.yml.
# It must be empty on the first deploy, or hold an installation of this code.
BASE=/opt/company

# Name of the container and of the compose project. A second installation on the same server needs another one.
NAME=company

# The UI listens on 127.0.0.1:PORT on the server. Reach it through an SSH tunnel:
#   ssh -L 8700:127.0.0.1:8700 admin@server.example   and then open http://127.0.0.1:8700
# Whoever wants HTTPS puts their own proxy in front and sets COMPANY_COOKIE_SECURE=on.
PORT=8700

# Time zone for transcripts and recurring tasks.
TZ=Europe/Berlin

# Docker network of the runs, by default <NAME>-agents. Attach the MCP services the employees shall use to this
# network, and give their container name as address on the page "Services", e.g. http://my-mcp:8000/mcp.
# A second installation on the same server needs a network of its own, or its runs reach the services of the first.
# COMPANY_NETWORK=company-agents

# Further settings of the service, see docs/operation.md, "Settings". Everything starting with COMPANY_ is passed on.
COMPANY_RUN_MEMORY=768m
# Telemetry and error reports of Claude Code in the runs; "off" switches them off.
# COMPANY_RUN_TELEMETRY=off
# COMPANY_COOKIE_SECURE=on
# COMPANY_CHANNEL_TOKEN=
